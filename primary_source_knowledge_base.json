  "search_strategies": {
    "government_press_release": {
      "priority_domains": [
        "gencat.cat",
        "govern.cat",
        "web.gencat.cat",
        "lamoncloa.gob.es",
        "gob.es"
      ],
      "query_templates": [
        "site:{domain} {publisher} comunicat {title}",
        "site:{domain}/ca/noticies/ {title}",
        "site:{domain}/ca/actualitat/ {title}"
      ]
    },
    "municipal_announcement": {
      "priority_domains": [
        "ajuntament.barcelona.cat",
        "badalona.cat"
      ],
      "query_templates": [
        "site:{domain}/premsa/ {title}",
        "site:{domain}/ca/noticia/ {title}"
      ]
    },
    "statistical_report": {
      "priority_domains": [
        "idescat.cat",
        "ceo.gencat.cat"
      ],
      "query_templates": [
        "site:{domain} {title} filetype:pdf",
        "site:{domain}/ca/estudis/ {title}",
        "site:{domain}/ca/barometre/ {title}"
      ]
    },
    "survey_barometer": {
      "priority_domains": [
        "ceo.gencat.cat"
      ],
      "query_templates": [
        "site:ceo.gencat.cat {title}",
        "site:ceo.gencat.cat/ca/barometre/ {title}"
      ]
    },
    "emergency_services": {
      "priority_domains": [
        "bombers.gencat.cat",
        "mossos.gencat.cat",
        "interior.gencat.cat",
        "sem.gencat.cat",
        "transit.gencat.cat"
      ],
      "query_templates": [
        "site:{domain} {title}",
        "site:{domain}/ca/noticies/ {title}"
      ]
    },
    "government_press_room": {
      "priority_domains": [
        "govern.cat"
      ],
      "query_templates": [
        "site:govern.cat/salapremsa/notes-premsa/ {title}",
        "site:govern.cat/salapremsa/ {title}"
      ]
    }
  },
  "validation_rules": {
    "forbidden_paths": [
      "/",
      "/index",
      "/home",
      "/about",
      "/qui-som",
      "/quienes-somos",
      "/nosotros",
      "/associacio",
      "/asociacion",
      "/contact",
      "/contacte",
      "/contacto",
      "/ca/",
      "/es/",
      "/en/"
    ],
    "required_path_depth": 3,
    "min_specific_segments": 1
  }
}
